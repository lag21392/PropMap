# Copiá a .env y completá. Docker Compose y PropMap leen este archivo.

SEARCH_PASSWORD=cambia-esta-clave
APP_PUBLIC_URL=https://propmaplag.duckdns.org

MATOMO_INTERNAL_URL=http://matomo
MATOMO_PUBLIC_URL=https://propmaplag.duckdns.org/stats
MATOMO_USER=admin
MATOMO_PASSWORD=cambia-esta-clave-12
MATOMO_EMAIL=admin@localhost.local
MATOMO_SITE_NAME=PropMap
MATOMO_SITE_URL=https://propmaplag.duckdns.org
MATOMO_TIMEZONE=America/Argentina/Buenos_Aires
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=cambia-esta-clave
MATOMO_DB_ROOT_PASSWORD=cambia-esta-clave

# Scrape: cada portal por el carril que ya funciona.
# Properati → traductor Yandex. ZonaProp/Argenprop (fichas) → IP de casa:
# 20 s por página, varias en paralelo. Un 403 pausa ~20 s ese sitio.
# Mercado Libre y listados → Tor.
# TOR_ENABLED=0 apaga Tor. SCRAPE_PROXIES=http://... para proxies propios.
TOR_ENABLED=1
TOR_SOCKS=socks5h://tor:9050
TOR_CIRCUITS=4
SCRAPE_USE_LOCAL=1
SCRAPE_LOCAL_GAP_SEC=20
SCRAPE_LOCAL_PARALLEL=4
SCRAPE_LOCAL_MAX_DAY=600
SCRAPE_PROXIES=
